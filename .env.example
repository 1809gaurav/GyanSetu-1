# ---------------------------------------------------------------------------
# Gyaansetu — link configuration
# Copy to `.env` for local use, or set these in the Vercel dashboard.
# Leave a value empty to render an honest disabled "Link coming soon" state.
# Rules: absolute https:// URLs only (http://localhost is allowed in dev).
# ---------------------------------------------------------------------------

# The hosted web app (sign-up, onboarding, dashboard)
VITE_APP_URL=

# The extension store listing or download page
VITE_EXTENSION_URL=

# Optional: privacy policy page
VITE_PRIVACY_URL=

# Contact (either an email or a page URL)
VITE_CONTACT_EMAIL=
VITE_CONTACT_URL=

# Social profiles
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=
VITE_INSTAGRAM_URL=
VITE_YOUTUBE_URL=
VITE_X_URL=

# Optional: hackathon name shown in the About section
VITE_HACKATHON_NAME=
